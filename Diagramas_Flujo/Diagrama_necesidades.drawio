        <mxCell id="gdO8PIqFqGc3pTqo627N-1" value="&lt;font face=&quot;Times New Roman&quot;&gt;&lt;b&gt;Necesidades del Algoritmo&lt;/b&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1">
          <mxGeometry x="310" y="20" width="160" height="20" as="geometry" />
        </mxCell>
        <mxCell id="gdO8PIqFqGc3pTqo627N-43" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="gdO8PIqFqGc3pTqo627N-10" target="gdO8PIqFqGc3pTqo627N-41" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="gdO8PIqFqGc3pTqo627N-10" value="&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;font-family: &amp;quot;Times New Roman&amp;quot;;&quot;&gt;Clasificación&lt;/span&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1">
          <mxGeometry x="350" y="70" width="80" height="20" as="geometry" />
        </mxCell>
        <mxCell id="gdO8PIqFqGc3pTqo627N-39" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="gdO8PIqFqGc3pTqo627N-11" target="gdO8PIqFqGc3pTqo627N-22" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="gdO8PIqFqGc3pTqo627N-11" value="&lt;font face=&quot;Times New Roman&quot;&gt;Detección&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1">
          <mxGeometry x="80" y="70" width="60" height="20" as="geometry" />
        </mxCell>
        <mxCell id="gdO8PIqFqGc3pTqo627N-22" value="&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;font face=&quot;Times New Roman&quot;&gt;Debe identificar el inicio y el fin de la perturbación.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;hr style=&quot;text-align: justify;&quot;&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;font face=&quot;Times New Roman&quot;&gt;Debe ser robusto frente al ruido, de forma que este no influya en la localización del evento.&lt;/font&gt;&lt;/div&gt;&lt;hr style=&quot;text-align: justify;&quot;&gt;&lt;font face=&quot;Times New Roman&quot;&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;Debe ser adaptable para sistemas monofásicos y trifásicos, puesto que existen diferencias en la adquisición de datos.&lt;/div&gt;&lt;/font&gt;&lt;hr style=&quot;text-align: justify;&quot;&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1">
          <mxGeometry x="22.5" y="110" width="175" height="170" as="geometry" />
        </mxCell>
        <mxCell id="gdO8PIqFqGc3pTqo627N-41" value="&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;font face=&quot;Times New Roman&quot;&gt;Debe clasificar si el hundimiento de tensión presenta otra característica asociada.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;hr style=&quot;text-align: justify;&quot;&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;font face=&quot;Times New Roman&quot;&gt;En los sistemas trifásicos, debe distinguir todos los tipos de desbalances.&lt;/font&gt;&lt;/div&gt;&lt;hr style=&quot;text-align: justify;&quot;&gt;&lt;font face=&quot;Times New Roman&quot;&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Debe tener al menos una precisión superior al 90% al distinguir las clases.&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;/font&gt;&lt;font face=&quot;Times New Roman&quot;&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;/div&gt;&lt;/font&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1">
          <mxGeometry x="262.5" y="110" width="255" height="130" as="geometry" />
        </mxCell>
        <mxCell id="gdO8PIqFqGc3pTqo627N-50" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="gdO8PIqFqGc3pTqo627N-44" target="gdO8PIqFqGc3pTqo627N-47" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="gdO8PIqFqGc3pTqo627N-44" value="&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;font-family: &amp;quot;Times New Roman&amp;quot;;&quot;&gt;Parametros&lt;/span&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" parent="1" vertex="1">
          <mxGeometry x="650" y="70" width="80" height="20" as="geometry" />
        </mxCell>
        <mxCell id="gdO8PIqFqGc3pTqo627N-47" value="&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;font face=&quot;Times New Roman&quot;&gt;Debe funcionar en sistemas de 60 Hz&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;hr style=&quot;text-align: justify;&quot;&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;font face=&quot;Times New Roman&quot;&gt;Debe ser adaptable a cualquier frecuencia de muestreo, porque debe estar diseñado para cualquier tamaño de ventana de muestras.&lt;/font&gt;&lt;/div&gt;&lt;hr style=&quot;text-align: justify;&quot;&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;font face=&quot;Times New Roman&quot;&gt;El tiempo de cómputo debe ser menor o igual a la duración de la ventana de análisis. Por ejemplo, si la ventana es de 1 segundo, el algoritmo debe dar una respuesta en ese mismo tiempo o menos.&lt;/font&gt;&lt;/div&gt;&lt;hr style=&quot;text-align: justify;&quot;&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" parent="1" vertex="1">
          <mxGeometry x="570" y="110" width="240" height="170" as="geometry" />
        </mxCell>
      </root>
