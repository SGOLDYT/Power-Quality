        <mxCell id="gdO8PIqFqGc3pTqo627N-22" value="&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;font-family: &amp;quot;Times New Roman&amp;quot;; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Debe identificar el inicio y fin de la perturbación.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;hr style=&quot;text-align: justify;&quot;&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;font face=&quot;Times New Roman&quot;&gt;Debe&amp;nbsp;ser robusto frente al ruido.&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;hr style=&quot;text-align: justify;&quot;&gt;&lt;font face=&quot;Times New Roman&quot;&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Debe ser adaptable para sistemas monofasicos y trifasicos&lt;/span&gt;&lt;/div&gt;&lt;/font&gt;&lt;hr style=&quot;text-align: justify;&quot;&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="25" y="110" width="170" height="110" as="geometry" />
        </mxCell>
        <mxCell id="gdO8PIqFqGc3pTqo627N-41" value="&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;font-family: &amp;quot;Times New Roman&amp;quot;; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Debe clasificar si el hundimiento de tensión presenta otra caracteristica asociada.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;hr style=&quot;text-align: justify;&quot;&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;font face=&quot;Times New Roman&quot;&gt;En los sistemas trifasicos debe distinguir todos los tipos de desbalances.&lt;/font&gt;&lt;/div&gt;&lt;hr style=&quot;text-align: justify;&quot;&gt;&lt;font face=&quot;Times New Roman&quot;&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Debe tener al menos una precisión mayor al 90%.&lt;/span&gt;&lt;/div&gt;&lt;/font&gt;&lt;hr style=&quot;text-align: justify;&quot;&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
